{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "附近美食推荐",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 80
      }
    },
    {
      "path": "pages/wheel/wheel",
      "style": {
        "navigationBarTitleText": "转盘抽奖"
      }
    },
    {
      "path": "pages/wheel-pick/wheel-pick",
      "style": {
        "navigationBarTitleText": "选择餐厅"
      }
    },
    {
      "path": "pages/detail/detail",
      "style": {
        "navigationBarTitleText": "餐厅详情"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/wheel-challenge/wheel-challenge",
      "style": {
        "navigationBarTitleText": "饭局轮盘 PK"
      }
    },
    {
      "path": "pages/list-manage/list-manage",
      "style": {
        "navigationBarTitleText": "列表管理"
      }
    }
  ],
  "globalStyle": {
    "navigationBarBackgroundColor": "#FF6B35",
    "navigationBarTitleText": "吃啥",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#F5F5F5"
  },
  "tabBar": {
    "color": "#999999",
    "selectedColor": "#FF6B35",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "附近美食",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/wheel/wheel",
        "text": "转盘抽奖",
        "iconPath": "static/tabbar/wheel.png",
        "selectedIconPath": "static/tabbar/wheel-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      }
    ]
  }
}
